{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx prettier *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Read(//c/Users/ADMIN/.claude/**)",
      "Edit(/.claude/skills/frontend-design/**)"
